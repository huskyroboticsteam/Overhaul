            itself.v[1] = tmp.v[0] * b.r[3] + tmp.v[1] * b.r[4] + tmp.v[2] * b.r[5];
            itself.v[2] = tmp.v[0] * b.r[6] + tmp.v[1] * b.r[7] + tmp.v[2] * b.r[8];
