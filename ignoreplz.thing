    /**
    \brief Generate a unique identifier for virtual stereo based on the serial numbers of the two ZED Ones
    \ingroup Video_group
    \param serial_left : Serial number of the left camera.
    \param serial_right : Serial number of the right camera.
    \return A unique hash for the given pair of serial numbers, or 0 if an error occurred (e.g: same serial number).
    */
    unsigned int SL_CORE_EXPORT generateVirtualStereoSerialNumber(unsigned int serial_left, unsigned int serial_right);

    /**
    \class InputType
    \ingroup Video_group
    \brief Class defining the input type used in the ZED SDK.

    It can be used to select a specific camera with an id or serial number, or from a SVO file.
     */
    class SL_CORE_EXPORT InputType {
        friend class Camera;
        friend class CameraMemberHandler;
        friend class CameraOneImpl;
        friend struct InitParameters;
        friend struct InitParametersOne;

    public:
        /**
        \brief Lists input types in the ZED SDK.
         */
        enum class INPUT_TYPE {
            USB_ID,      /**< USB input from an id*/
            USB_SERIAL,  /**< USB input from a serial number*/
            SVO_FILE,    /**< SVO file input*/
            STREAM,      /**< STREAM input (requires to use \ref Camera.enableStreaming "enableStreaming()" / \ref Camera.disableStreaming
                            "disableStreaming()"" on the "sender" side) */
            GMSL_ID,     /**< GMSL input from an id (only on NVIDIA Jetson) */
            GMSL_SERIAL, /**< GMSL input from a serial number (only on NVIDIA Jetson) */
            GMSL_PORT,   /**< GMSL input from a physical GMSL port (only on NVIDIA Jetson) */
            AUTO,        /**< AUTO input type, automatically selects the right input type among the buses the host supports */
            MIPI_ID,     /**< MIPI input from an id (only on NVIDIA Jetson) */
            MIPI_SERIAL, /**< MIPI input from a serial number (only on NVIDIA Jetson) */
            MIPI_PORT,   /**< MIPI input from a physical port of the MIPI capture card (only on NVIDIA Jetson) */
            HOLOSCAN_ID, /**< Holoscan Camera-over-Ethernet input from an id (only on NVIDIA Jetson) */
            HOLOSCAN_SERIAL, /**< Holoscan Camera-over-Ethernet input from a serial number (only on NVIDIA Jetson) */
            HOLOSCAN_PORT,   /**< Holoscan Camera-over-Ethernet input from a physical output of the sensor bridge (only on NVIDIA Jetson) */
            ///@cond SHOWHIDDEN
            LAST
            ///@endcond
        };

        /**
        \brief Default constructor.
         */
        InputType();

        /**
        \brief Copy constructor.
         */
        InputType(const InputType& input_type) = default;

        /**
        \brief Set the input as the camera with specified id.
        \note The id is not related to the serial number of the camera. The id is assigned by the OS depending on the order the cameras are
        plugged. \warning Using id is not recommended if you have multiple cameras plugged in the system, prefer using the serial number
        instead. \param id : Id of the camera to open. The default, -1, will open the first available camera. A number >= 0 will try to open
        the camera with the corresponding id. \param bus_type : Which bus the camera is on: USB, GMSL, MIPI or Holoscan.
         */
        void setFromCameraID(int id = -1, sl::BUS_TYPE bus_type = sl::BUS_TYPE::AUTO);

        /**
        \brief Set the input as the camera with specified serial number.
        \param camera_serial_number : Serial number of the camera to open.
         */
        void setFromSerialNumber(unsigned int camera_serial_number);

        /**
        \brief Set the input as the sensor with specified serial number (string version).

        For ZED/ZEDOne cameras, the string is parsed to an unsigned int and the standard method is called.
        For Lidar sensors (which have string-based serial numbers like "991937000508"), the string is used directly
        for device discovery and matching.
        \param serial_number : Serial number of the sensor to open (as a string).
         */
        void setFromSerialNumber(sl::String serial_number);

        /**
        \brief Set the input as the camera with specified GMSL port.
        \param gmsl_port : GMSL port number of the camera to open. Default: -1. Any number < 0 will try to open the first available GMSL
        camera. \note Only available on NVIDIA Jetson platforms with GMSL cameras.
         */
        void setFromGMSLPort(int gmsl_port = -1);

        /**
        \brief Set the input as the camera with specified MIPI port.
        \param mipi_port : Port number of the MIPI capture card the camera to open is connected to. Default: -1. Any number < 0 will try to
        open the first available MIPI camera. \note Only available on NVIDIA Jetson platforms with MIPI cameras.
         */
        void setFromMIPIPort(int mipi_port = -1);

        /**
        \brief Set the input as the camera on the specified output of the Holoscan sensor bridge.
        \param holoscan_port : Output number of the sensor bridge the camera to open is connected to. Default: -1. Any number < 0 will try
        to open the first available Holoscan camera. \note Only available on NVIDIA Jetson platforms with a Holoscan sensor bridge.
         */
        void setFromHoloscanPort(int holoscan_port = -1);

        /**
        \brief Set the input as the SVO specified with the filename.
        \param svo_input_filename : Path of the SVO file to open.
         */
        void setFromSVOFile(sl::String svo_input_filename);

        /**
        \brief Set the input as the stream defined by the IP address and the port of the sending device.
        \param sender_ip : IP address of the streaming sender.
        \param port : Port on which to listen. Default: 30000
        \note The protocol used for the streaming module is based on RTP/RTCP.
        \warning Port must be even number, since the port+1 is used for control data.
         */
        void setFromStream(sl::String sender_ip, unsigned short port = 30000);

        /**
        \brief Returns the current input type.
         */
        INPUT_TYPE getType() const {
            return type;
        }

        /**
        \brief Returns the current input configuration as a string e.g: SVO name, serial number, streaming ip, etc.
         */
        sl::String getConfiguration() const {
            return configuration;
        }

        /**
        \brief Check whether the input is set.
         */
        bool isInit() const {
            return init_;
        }

        /**
        \brief Set the input as the ZED Ones with specified ids for a virtual stereo rig
        \param id_left : Id of the left ZED One camera to open.
        \param id_right : Id of the right ZED One camera to open.
        \param virtual_serial_number : Serial number of the virtual stereo rig to load its custom calibration
        \note: The virtual serial number must fall within an interval that reflects the Product ID range.
        This is necessary to avoid, for instance, downloading calibration data from an unrelated product.
        The valid range is 110000000 to 119999999.
        A support function can be used, based on the ZED One serial number, to compute a valid virtual serial number: \ref
        sl::generateVirtualStereoSerialNumber \return true if an error occurred (invalid ids or virtual serial number), false on success.
         */
        bool setVirtualStereoFromCameraIDs(int id_left, int id_right, unsigned int virtual_serial_number);

        /**
        \brief Set the input as the ZED Ones with specified serial numbers for a virtual stereo rig
        \param camera_left_serial_number : Serial number of the left ZED One camera to open.
        \param camera_right_serial_number : Serial number of the right ZED One camera to open.
        \param virtual_serial_number : Serial number of the virtual stereo rig to load its custom calibration
        \note: The virtual serial number must fall within an interval that reflects the Product ID range.
        This is necessary to avoid, for instance, downloading calibration data from an unrelated product.
        The valid range is 110000000 to 119999999.
        A support function can be used, based on the ZED One serial number, to compute a valid virtual serial number: \ref
        sl::generateVirtualStereoSerialNumber \return true if an error occurred (invalid serial numbers or virtual serial number), false on
        success.
         */
        bool setVirtualStereoFromSerialNumbers(
            unsigned int camera_left_serial_number,
            unsigned int camera_right_serial_number,
            unsigned int virtual_serial_number
        );

        /**
        \brief Saves the current set of parameters into a file to be reloaded with the \ref load() method.
        \param filename : Name of the file which will be created to store the parameters (extension '.yml' will be added if not set).
        \return True if file was successfully saved, otherwise false.
        \warning For security reason, the file must not exist.
        \warning In case a file already exists, the method will return false and existing file will not be updated.
         */
        bool save(String filename) const;

        /**
        \brief Loads a set of parameters from the values contained in a previously \ref save() "saved" file.
        \param filename : Path to the file from which the parameters will be loaded  (extension '.yml' will be added at the end of the
        filename if not set). \return True if the file was successfully loaded, otherwise false.

        \code
        InitParameters init_params; // Set initial parameters
        init_params.load("initParameters.yml"); // Load the init_params from a previously exported file
        \endcode

        \note As the InitParameters files can be easily modified manually (using a text editor) this function allows you to test various
        settings without re-compiling your application.
         */
        bool load(String filename);

        /**
        \brief Generate a JSON Object (with the struct type as a key) containing the serialized struct, converted into a string
        \param serialized_content: output string containing the JSON Object
        \return True if file was successfully saved, otherwise false.
         */
        bool encode(String& serialized_content) const;

        /**
        \brief Fill the structure from the serialized json object contained in the input string
        \param serialized_content: input string containing the JSON Object
        \return True if the decoding was successful, otherwise false.
         */
        bool decode(const String& serialized_content);

        /**
         * @brief Comparison operator ==
         * @param param1 to compare
         * @return true if the two struct are identical
         */
        bool operator==(const InputType& param1) const;

        /**
         * @brief  Comparison operator !=
         * @param param1 to compare
         * @return true if the two struct are different
         */
        bool operator!=(const InputType& param1) const;

    private:
        INPUT_TYPE type = INPUT_TYPE::LAST;
        sl::String configuration = "0";
        bool init_ = false;

        sl::String configuration_right = "0";
        bool virtual_stereo_mode_ = false;
        unsigned int virtual_serial_number_ = 0;
    };

    ///@cond SHOWHIDDEN
    String SL_CORE_EXPORT toString(const sl::InputType::INPUT_TYPE& input_type);
    bool SL_CORE_EXPORT fromString(const sl::String& input_type_str, sl::InputType::INPUT_TYPE& input_type);

    inline std::ostream& operator<<(std::ostream& os, const InputType::INPUT_TYPE& input_type) {
        return os << toString(input_type);
    }
    ///@endcond

    /**
    \enum OBJECT_DETECTION_MODEL
    \ingroup Object_group
    \brief Lists available models for the object detection module.
     */
    enum class OBJECT_DETECTION_MODEL {
        MULTI_CLASS_BOX_FAST,     /**< Any objects, bounding box based. */
        MULTI_CLASS_BOX_MEDIUM,   /**< Any objects, bounding box based, compromise between accuracy and speed. */
        MULTI_CLASS_BOX_ACCURATE, /**< Any objects, bounding box based, more accurate but slower than the base model. */
        PERSON_HEAD_BOX_FAST, /**< Bounding box detector specialized in person heads particularly well suited for crowded environments. The
                                 person localization is also improved. */
        PERSON_HEAD_BOX_ACCURATE, /**< Bounding box detector specialized in person heads, particularly well suited for crowded environments.
                                     The person localization is also improved, more accurate but slower than the base model.*/
        CUSTOM_BOX_OBJECTS, /**< For external inference, using your own custom model and/or frameworks. This mode disables the internal
                               inference engine, the 2D bounding box detection must be provided. */
        CUSTOM_YOLOLIKE_BOX_OBJECTS, /**< For internal inference using your own custom YOLO-like model. This mode requires a onnx file to be
                                        passed in the ObjectDetectionParameters. This model will be used for inference. */
        CUSTOM_RFDETRLIKE_BOX_OBJECTS, /**< For internal inference using your own custom RF-DETR / DETR-like model (two outputs: boxes +
                                          class logits, NMS-free). Requires a onnx file in the ObjectDetectionParameters. */
        CUSTOM_BOX_OBJECTS_AUTODETECT, /**< For internal inference using your own custom ONNX model, auto-detecting whether it is YOLO-like
                                          or RF-DETR/DETR-like from the model output structure. Requires a onnx file. Recommended default
                                          for custom models. */
        ///@cond SHOWHIDDEN
        LAST
        ///@endcond
    };

    ///@cond SHOWHIDDEN
    String SL_CORE_EXPORT toString(const OBJECT_DETECTION_MODEL& input_type);
    bool SL_CORE_EXPORT fromString(const sl::String& input_type_str, sl::OBJECT_DETECTION_MODEL& input_type);

    inline std::ostream& operator<<(std::ostream& os, const OBJECT_DETECTION_MODEL& input_type) {
        return os << toString(input_type);
    }
    ///@endcond

    /**
    \enum BODY_TRACKING_MODEL
    \ingroup Body_group
    \brief Lists available models for the body tracking module.
     */
    enum class BODY_TRACKING_MODEL {
        HUMAN_BODY_FAST,     /**< Keypoints based, specific to human skeleton, real time performance even on Jetson or low end GPU cards. */
        HUMAN_BODY_MEDIUM,   /**< Keypoints based, specific to human skeleton, compromise between accuracy and speed. */
        HUMAN_BODY_ACCURATE, /**< Keypoints based, specific to human skeleton, state of the art accuracy, requires powerful GPU. */
        ///@cond SHOWHIDDEN
        LAST
        ///@endcond
    };

    ///@cond SHOWHIDDEN
    String SL_CORE_EXPORT toString(const BODY_TRACKING_MODEL& input_type);
    bool SL_CORE_EXPORT fromString(const sl::String& input_type_str, sl::BODY_TRACKING_MODEL& input_type);

    inline std::ostream& operator<<(std::ostream& os, const BODY_TRACKING_MODEL& input_type) {
        return os << toString(input_type);
    }
    ///@endcond

    /**
    \enum BODY_TRACKING_MODEL_GEN
    \ingroup Body_group
    \brief Lists the generations of neural network available for the body tracking module.

    A generation is only available for some combinations of sl::BODY_TRACKING_MODEL and sl::BODY_FORMAT: when the requested one
    has no network for it, the ZED SDK falls back to the most recent generation it does have.
     */
    enum class BODY_TRACKING_MODEL_GEN {
        GEN_1, /**< Network used up to ZED SDK 5.4. Only generation available for [sl::BODY_FORMAT::BODY_38](\ref BODY_FORMAT). */
        GEN_2, /**< Default. Bottom-up network introduced in ZED SDK 5.5, more robust in crowded scenes and to unusual poses.
                    Available for [sl::BODY_TRACKING_MODEL::HUMAN_BODY_MEDIUM](\ref BODY_TRACKING_MODEL) and
                    [sl::BODY_TRACKING_MODEL::HUMAN_BODY_ACCURATE](\ref BODY_TRACKING_MODEL) with
                    [sl::BODY_FORMAT::BODY_18](\ref BODY_FORMAT) or [sl::BODY_FORMAT::BODY_34](\ref BODY_FORMAT).
                    [sl::BODY_TRACKING_MODEL::HUMAN_BODY_FAST](\ref BODY_TRACKING_MODEL) and
                    [sl::BODY_FORMAT::BODY_38](\ref BODY_FORMAT) have GEN_1 only, and fall back to it. */
        ///@cond SHOWHIDDEN
        LAST
        ///@endcond
    };

    ///@cond SHOWHIDDEN
    String SL_CORE_EXPORT toString(const BODY_TRACKING_MODEL_GEN& input_type);
    bool SL_CORE_EXPORT fromString(const sl::String& input_type_str, sl::BODY_TRACKING_MODEL_GEN& input_type);

    inline std::ostream& operator<<(std::ostream& os, const BODY_TRACKING_MODEL_GEN& input_type) {
        return os << toString(input_type);
    }
    ///@endcond

