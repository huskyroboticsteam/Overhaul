    /**
    \enum ENCODED_STREAM_SOURCE
    \ingroup Video_group
    \brief Identifies which of the camera's encoded video paths to read from.

    A single \ref Camera can produce up to three concurrent encoded H264/H265
    bitstreams: the incoming stream when the camera is opened from a network
    sender (\ref ENCODED_STREAM_SOURCE::RECEIVING), the outgoing stream when
    \ref Camera::enableStreaming() is active (\ref
    ENCODED_STREAM_SOURCE::SENDING), and the SVO encoder output when
    \ref Camera::enableRecording() is active with a video compression mode
    (\ref ENCODED_STREAM_SOURCE::RECORDING). Each source has its own codec,
    bitrate and key-frame schedule.
     */
    enum class ENCODED_STREAM_SOURCE {
        RECEIVING = 0, ///< Incoming stream packets (Camera opened with INPUT_TYPE::STREAM).
        SENDING = 1,   ///< Outgoing stream packets (enableStreaming() is active).
        RECORDING = 2, ///< SVO encoder output (enableRecording() with H264 / H265 compression mode).
        LAST           ///< Sentinel.
    };

    ///@cond SHOWHIDDEN
    String SL_CORE_EXPORT toString(const ENCODED_STREAM_SOURCE& stream_source);
    bool SL_CORE_EXPORT fromString(const sl::String& stream_source_str, ENCODED_STREAM_SOURCE& stream_source);

    inline std::ostream& operator<<(std::ostream& os, const ENCODED_STREAM_SOURCE& stream_source) {
        return os << toString(stream_source);
    }
    ///@endcond

