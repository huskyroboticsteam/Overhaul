        DGNSS = 2,
        /**
        @brief Precise Positioning Service
         */
        PPS = 5,
        /**
        @brief Real Time Kinematic Float
         */
        RTK_FLOAT = 4,
        /**
        @brief Real Time Kinematic Fixed
        */
        RTK_FIX = 3,
        LAST
    };

    ///@cond SHOWHIDDEN
