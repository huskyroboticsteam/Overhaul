    /**
    \ingroup Video_group
    \brief Structure containing information about the properties of a camera.

    \note A \ref camera_model \ref MODEL "sl::MODEL::ZED_M" with an id '-1' can be due to an inverted USB-C cable.
     */
    struct DeviceProperties {
        /**
        \brief State of the camera.

        Default: \ref CAMERA_STATE "sl::CAMERA_STATE::NOT_AVAILABLE"
         */
        sl::CAMERA_STATE camera_state = sl::CAMERA_STATE::NOT_AVAILABLE;

        /**
        \brief Id of the camera.

        Default: -1
         */
        int id = -1;

        /**
        \brief System path of the camera.
         */
        sl::String path;

        /**
        \brief Video device of camera
         */
        sl::String video_device;

        /**
        \brief i2c port of the camera.
         */
        int i2c_port = 0;

        /**
        \brief Model of the camera.
         */
        sl::MODEL camera_model = sl::MODEL::LAST;

        /**
        \brief Serial number of the camera.

        Default: 0
        \warning Not provided for Windows.
         */
        unsigned int serial_number = 0;

        /**
        \brief GMSL port of the camera.
         */
        int gmsl_port = -1;

        /**
        \brief [Cam model, eeprom version, white balance param]
         */
        unsigned char identifier[3] = {0};

        /**
        \brief Badge name (zedx_ar0234)
         */
        sl::String camera_badge = "";

        /**
        \brief Name of sensor (zedx)
         */
        sl::String camera_sensor_model = "";

        /**
        \brief Name of Camera in DT (ZED_CAM1)
         */
        sl::String camera_name = "";

        /**
        \brief Input type of the camera.
         */
        INPUT_TYPE input_type = sl::INPUT_TYPE::LAST;

        /**
        \brief sensor_address when available (ZED-X HDR/XOne HDR only)
         */
        unsigned char sensor_address_left = 0;
        unsigned char sensor_address_right = 0;
    };

    ///@cond SHOWHIDDEN
    String SL_CORE_EXPORT toString(const DeviceProperties& properties);

    inline std::ostream& operator<<(std::ostream& os, const DeviceProperties& properties) {
        return os << toString(properties);
    }
    ///@endcond

    /**
    \enum COMPUTE_PREFERENCE
    \ingroup Core_group
    \brief Lists how much GPU a module is allowed to use.
    \note The selected mode sets a floor that cannot be avoided: for example
    \ref POSITIONAL_TRACKING_MODE::GEN_1 computes depth and therefore always uses the GPU.
    This preference only controls the work that is optional on top of that floor.
     */
    enum class COMPUTE_PREFERENCE {
        AUTO,       /**< Default. Let the SDK choose. For positional tracking, \ref POSITIONAL_TRACKING_MODE::GEN_3 runs on the CPU and \ref
                       POSITIONAL_TRACKING_MODE::GEN_1 uses the GPU, since it computes depth.*/
        PREFER_CPU, /**< Use no more GPU than the selected mode requires, leaving the GPU free for your own workloads. Tracking is slower
                       than with GPU acceleration.*/
        PREFER_GPU, /**< Use GPU acceleration wherever it is available, which makes tracking faster and lowers the per-frame time of
                       sl::Camera::grab(). Falls back to the CPU by itself if the GPU cannot be used.*/
        PREFER_ACCELERATORS, /**< Experimental. Run work on the device's dedicated accelerators where there are some, leaving the CPU and
                                the GPU free, and decide the rest as \ref COMPUTE_PREFERENCE::AUTO. For positional tracking, \ref
                                POSITIONAL_TRACKING_MODE::GEN_3 then runs its image preprocessing and feature tracking on the PVA of a
                                Jetson AGX Orin or Orin NX (JetPack 6 or 7.2) or of a Jetson Thor (JetPack 7.2), for the same poses as on
                                the CPU: it uses less CPU, and can add latency (about 2 ms per frame with JetPack 7.2). Elsewhere it is \ref
                                COMPUTE_PREFERENCE::AUTO.*/
        ///@cond SHOWHIDDEN
        LAST
        ///@endcond
    };

    ///@cond SHOWHIDDEN
    String SL_CORE_EXPORT toString(const COMPUTE_PREFERENCE& compute_preference);
    bool SL_CORE_EXPORT fromString(const String& compute_preference_str, COMPUTE_PREFERENCE& compute_preference);

    inline ::std::ostream& operator<<(::std::ostream& os, const COMPUTE_PREFERENCE& compute_preference) {
        return os << toString(compute_preference);
    }
    ///@endcond

    /**
    \enum LENS_DISTORTION_MODEL
    \ingroup Core_group
    \brief Lists the lens distortion models used to describe a camera's optics.
    \note The value is tied to the rectification state of the sl::CameraParameters it belongs to:
    raw/unrectified parameters are always RAD_TAN or FISHEYE, rectified parameters are always PINHOLE.
    Code working on raw parameters may treat "not FISHEYE" as RAD_TAN, but must not assume that on
    parameters that could be rectified.
     */
    enum class LENS_DISTORTION_MODEL {
        RAD_TAN, /**< Radial-tangential (Brown-Conrady) distortion. Used by raw/unrectified parameters. */
        FISHEYE, /**< Fisheye distortion. Used by raw/unrectified parameters. */
        PINHOLE, /**< Pinhole model, no distortion. Used by rectified parameters. */
        ///@cond SHOWHIDDEN
        LAST
        ///@endcond
    };

    ///@cond SHOWHIDDEN
    String SL_CORE_EXPORT toString(const LENS_DISTORTION_MODEL& model);

    inline std::ostream& operator<<(std::ostream& os, const LENS_DISTORTION_MODEL& model) {
        return os << toString(model);
    }
    ///@endcond

    /**
    \struct CameraParameters
    \ingroup Depth_group
    \brief Structure containing the intrinsic parameters of a camera.

    That information about the camera will be returned by sl::Camera.getCameraInformation().
    \note Similar to the sl::CalibrationParameters, those parameters are taken from the settings file (SNXXX.conf) and are modified during
    the sl::Camera.open() call when running a self-calibration). \note Those parameters given after sl::Camera.open() call, represent the
    camera matrix corresponding to rectified or unrectified images. \note When filled with rectified parameters, fx, fy, cx, cy must be the
    same for left and right camera once sl::Camera.open() has been called. \note Since distortion is corrected during rectification,
    distortion should not be considered on rectified images.
     */
    struct CameraParameters {
        /**
        \brief Focal length in pixels along x axis.
         */
        float fx = 0.f;

        /**
        \brief Focal length in pixels along y axis.
         */
        float fy = 0.f;

        /**
        \brief Optical center along x axis, defined in pixels (usually close to width / 2).
         */
        float cx = 0.f;

        /**
        \brief Optical center along y axis, defined in pixels (usually close to height / 2).
         */
        float cy = 0.f;

        /**
        \brief Distortion factor : [k1, k2, p1, p2, k3, k4, k5, k6, s1, s2, s3, s4].

        Radial (k1, k2, k3, k4, k5, k6), Tangential (p1,p2) and Prism (s1, s2, s3, s4) distortion.
         */
        double disto[12] = {0.};

        /**
        \brief Vertical field of view, in degrees.
         */
        float v_fov = 0.f;

        /**
        \brief Horizontal field of view, in degrees.
         */
        float h_fov = 0.f;

        /**
        \brief Diagonal field of view, in degrees.
         */
        float d_fov = 0.f;

        /**
        \brief Size in pixels of the images given by the camera.
         */
        Resolution image_size = Resolution(0, 0);

        /**
        \brief Real focal length in millimeters.
         */
        float focal_length_metric = 0.f;

        /**
        \brief Lens distortion model of these parameters.
        \note Raw/unrectified parameters are sl::LENS_DISTORTION_MODEL::RAD_TAN or sl::LENS_DISTORTION_MODEL::FISHEYE.
        \note Rectified parameters are sl::LENS_DISTORTION_MODEL::PINHOLE (distortion corrected).
         */
        LENS_DISTORTION_MODEL lens_distortion_model = LENS_DISTORTION_MODEL::RAD_TAN;

        /**
        \brief Return the sl::CameraParameters for another resolution.
        \param output_resolution : Resolution in which to get the new sl::CameraParameters.
        \return The sl::CameraParameters for the resolution given as input.
         */
        CameraParameters scale(sl::Resolution const& output_resolution) const {
            sl::CameraParameters calib_out = (*this);
            float rx = static_cast<float>(output_resolution.width) / static_cast<float>(image_size.width);
            float ry = static_cast<float>(output_resolution.height) / static_cast<float>(image_size.height);

            calib_out.fx = fx * rx;
            calib_out.fy = fy * ry;
            calib_out.cx = cx * rx;
            calib_out.cy = cy * ry;
            calib_out.image_size = output_resolution;
            memcpy(calib_out.disto, disto, sizeof(disto));

            return calib_out;
        }
    };

    /**
    \enum STREAMING_CODEC
    \ingroup Video_group
    \brief Lists the different encoding types for image streaming.
     */
    enum class STREAMING_CODEC {
        H264, /**< AVCHD/H264 encoding*/
        H265, /**< HEVC/H265 encoding*/
        ///@cond SHOWHIDDEN
        LAST
        ///@endcond
    };

    ///@cond SHOWHIDDEN
    String SL_CORE_EXPORT toString(const STREAMING_CODEC& codec);
