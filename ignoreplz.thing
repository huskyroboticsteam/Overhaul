#ifndef SL_CORE_UTILS_PLATFORM_HPP
#define SL_CORE_UTILS_PLATFORM_HPP

// Single source of truth for the target-platform macros. Include this instead of
// sniffing architecture macros.
//
//   _SL_JETSON_       NVIDIA Tegra/L4T platform: Argus/MMAPI, NvBufSurface, GMSL,
//                     V4L2 hardware codecs, /etc/nv_tegra_release.
//   _SL_DESKTOP_ARM_  aarch64 with the desktop/SBSA driver stack (DGX Spark, GH200,
//                     ARM servers): desktop NVENC/NVDEC (libnvidia-encode/libnvcuvid),
//                     no Tegra APIs.
//
// Architecture concerns (NEON vs SSE, alignment, ...) must be tested with
// __arm__/__aarch64__, never with these platform macros.
//
// The SDK build sets _SL_DESKTOP_ARM_ from CMake (lib/cmake/utils/variables.cmake:
// aarch64 without /etc/nv_tegra_release). For applications compiling against an
// installed SDK, the packaging step pins the platform on the line below.
// @SL_PLATFORM_PIN@

#if defined(_SL_JETSON_) && defined(_SL_DESKTOP_ARM_)
    #error "_SL_JETSON_ and _SL_DESKTOP_ARM_ are mutually exclusive"
#endif

#if (defined(__arm__) || defined(__aarch64__)) && !defined(_SL_DESKTOP_ARM_) && !defined(_SL_JETSON_)
    // Historical default: ARM implies Jetson unless the build states otherwise.
    #define _SL_JETSON_
#endif

#endif // SL_CORE_UTILS_PLATFORM_HPP
#ifndef __TYPES_HPP__
#define __TYPES_HPP__

