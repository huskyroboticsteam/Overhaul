        LEFT_HAND_INDEX_1 = 32, /**< 32*/  // knuckle
        RIGHT_HAND_INDEX_1 = 33,           /**< 33*/
        LEFT_HAND_MIDDLE_4 = 34, /**< 34*/ // tip
