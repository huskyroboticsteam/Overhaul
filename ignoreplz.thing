    enum class MEM {
        CPU = 1,  /**< Data will be stored on the CPU (processor side).*/
        GPU = 2,  /**< Data will be stored on the GPU (graphic card side).*/
        BOTH = 3, /**< Data will be stored on the GPU and CPU.*/
        LAST = 4
    };

    ///@cond SHOWHIDDEN
    String SL_CORE_EXPORT toString(const sl::MEM& mem);

