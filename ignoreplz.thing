    enum class INFERENCE_PRECISION {
        FP32 = 0,
        FP16 = 1,
        INT8 = 2,
        ///@cond SHOWHIDDEN
        LAST = 3
        ///@endcond
    };

    ///@cond SHOWHIDDEN
