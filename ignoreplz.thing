    /**
    \enum AI_MODELS
    \ingroup Object_group
    \brief Lists available AI models.
     */
    enum class AI_MODELS {
        MULTI_CLASS_DETECTION,          /**< Related to [sl::OBJECT_DETECTION_MODEL::MULTI_CLASS_BOX_FAST](\ref OBJECT_DETECTION_MODEL)*/
        MULTI_CLASS_MEDIUM_DETECTION,   /**< Related to [sl::OBJECT_DETECTION_MODEL::MULTI_CLASS_BOX_MEDIUM](\ref OBJECT_DETECTION_MODEL)*/
        MULTI_CLASS_ACCURATE_DETECTION, /**< Related to [sl::OBJECT_DETECTION_MODEL::MULTI_CLASS_BOX_ACCURATE](\ref
                                           OBJECT_DETECTION_MODEL)*/
        HUMAN_BODY_FAST_DETECTION,      /**< Related to [sl::BODY_TRACKING_MODEL::HUMAN_BODY_FAST](\ref BODY_TRACKING_MODEL)*/
        HUMAN_BODY_MEDIUM_DETECTION,    /**< Related to [sl::BODY_TRACKING_MODEL::HUMAN_BODY_MEDIUM](\ref BODY_TRACKING_MODEL)*/
        HUMAN_BODY_ACCURATE_DETECTION,  /**< Related to [sl::BODY_TRACKING_MODEL::HUMAN_BODY_ACCURATE](\ref BODY_TRACKING_MODEL)*/
        HUMAN_BODY_38_FAST_DETECTION,   /**< Related to [sl::BODY_TRACKING_MODEL::HUMAN_BODY_FAST](\ref BODY_TRACKING_MODEL)*/
        HUMAN_BODY_38_MEDIUM_DETECTION, /**< Related to [sl::BODY_TRACKING_MODEL::HUMAN_BODY_FAST](\ref BODY_TRACKING_MODEL)*/
        HUMAN_BODY_38_ACCURATE_DETECTION, /**< Related to [sl::BODY_TRACKING_MODEL::HUMAN_BODY_FAST](\ref BODY_TRACKING_MODEL)*/
        PERSON_HEAD_DETECTION,            /**< Related to [sl::OBJECT_DETECTION_MODEL::PERSON_HEAD_BOX_FAST](\ref OBJECT_DETECTION_MODEL)*/
        PERSON_HEAD_ACCURATE_DETECTION,   /**< Related to [sl::OBJECT_DETECTION_MODEL::PERSON_HEAD_BOX_ACCURATE](\ref
                                             OBJECT_DETECTION_MODEL)*/
        REID_ASSOCIATION,                 /**< Related to sl::BatchParameters.enable*/
        NEURAL_LIGHT_DEPTH,               /**< Related to [sl::DEPTH_MODE::NEURAL_LIGHT](\ref DEPTH_MODE)*/
        NEURAL_DEPTH,                     /**< Related to [sl::DEPTH_MODE::NEURAL](\ref DEPTH_MODE)*/
        NEURAL_PLUS_DEPTH,                /**< Related to [sl::DEPTH_MODE::NEURAL_PLUS](\ref DEPTH_MODE)*/
        NEURAL_DEPTH_INT8,                /**< Related to [sl::DEPTH_MODE::NEURAL](\ref DEPTH_MODE) with
                                               [sl::DEPTH_PRECISION::INT8](\ref DEPTH_PRECISION).
                                               \note It uses the model file of [sl::AI_MODELS::NEURAL_DEPTH](\ref AI_MODELS)
                                               with an engine of its own: optimizing one does not optimize the other.
                                               Optimize this entry too if the application may open the camera with
                                               sl::DEPTH_PRECISION::INT8.*/
        NEURAL_LIGHT_DEPTH_INT8,          /**< Related to [sl::DEPTH_MODE::NEURAL_LIGHT](\ref DEPTH_MODE) with
                                               [sl::DEPTH_PRECISION::INT8](\ref DEPTH_PRECISION).
                                               \note This is a model of its own, in the model file of
                                               [sl::AI_MODELS::NEURAL_LIGHT_DEPTH](\ref AI_MODELS), with an engine of its
                                               own: optimizing one does not optimize the other. Optimize this entry too if the application may
                                               open the camera with sl::DEPTH_MODE::NEURAL_LIGHT and
                                               sl::DEPTH_PRECISION::INT8. On a GPU that cannot run it, NEURAL_LIGHT runs
                                               in FP16, from sl::AI_MODELS::NEURAL_LIGHT_DEPTH.*/
        NEURAL_MAX_DEPTH,                 /**< Related to [sl::DEPTH_MODE::NEURAL_MAX](\ref DEPTH_MODE)*/
        NEURAL_PLUS_DEPTH_INT8,           /**< Related to [sl::DEPTH_MODE::NEURAL_PLUS](\ref DEPTH_MODE) with
                                               [sl::DEPTH_PRECISION::INT8](\ref DEPTH_PRECISION).
                                               \note It uses the model file of [sl::AI_MODELS::NEURAL_PLUS_DEPTH](\ref AI_MODELS)
                                               with an engine of its own: optimizing one does not optimize the other.
                                               Optimize this entry too if the application may
                                               open the camera with sl::DEPTH_MODE::NEURAL_PLUS and
                                               sl::DEPTH_PRECISION::INT8. On a GPU that cannot run it, NEURAL_PLUS runs
                                               in FP16, from sl::AI_MODELS::NEURAL_PLUS_DEPTH.*/
        NEURAL_MAX_DEPTH_INT8,            /**< Related to [sl::DEPTH_MODE::NEURAL_MAX](\ref DEPTH_MODE) with
                                               [sl::DEPTH_PRECISION::INT8](\ref DEPTH_PRECISION).
                                               \note It uses the model file of [sl::AI_MODELS::NEURAL_MAX_DEPTH](\ref AI_MODELS)
                                               with an engine of its own: optimizing one does not optimize the other.
                                               Optimize this entry too if the application may
                                               open the camera with sl::DEPTH_MODE::NEURAL_MAX and
                                               sl::DEPTH_PRECISION::INT8. On a GPU that cannot run it, NEURAL_MAX runs
                                               in FP16, from sl::AI_MODELS::NEURAL_MAX_DEPTH.*/
        ///@cond SHOWHIDDEN
        LAST
        ///@endcond
    };

