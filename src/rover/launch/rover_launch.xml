<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <arg name="backend" default="fake" />
    <arg name="enable_motor" default="false" />
    <arg name="motor_uuid" default="-1" />
    <arg name="gear_ratio" default="0.0" />
    <arg name="input_mode" default="twist" />
    <arg name="can_interface" default="can0" />
    <node pkg="rover" exec="Rover" name="rover">
        <param name="peripheral" value="launch" />
    </node>
    <include file="$(find-pkg-share rover)/launch/drive_launch.py">
        <arg name="backend" value="$(var backend)" />
        <arg name="enable_motor" value="$(var enable_motor)" />
        <arg name="motor_uuid" value="$(var motor_uuid)" />
        <arg name="gear_ratio" value="$(var gear_ratio)" />
        <arg name="input_mode" value="$(var input_mode)" />
        <arg name="can_interface" value="$(var can_interface)" />
    </include>
</launch>
